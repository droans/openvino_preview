+// Reproducer: Gemma 4 uses Sigmoid-based routing without Divide normalization.
+// Routing pattern: MatMul → Sigmoid → TopK → Multiply(Sigmoid, TopK_values) → Slice → Transpose → Unsqueeze.
+// FuseMOE3GemmCompressed expects Divide-based normalization (Softmax or Sigmoid+bias) and does NOT fire.
+TEST_F(TransformationTestsF, FuseMOE3GemmCompressed_GemmaRoutingNotMatched) {
+    const size_t tokens = 32;
+    const size_t hidden_size = 2048;
+    const size_t inter_size = 768;
+    const size_t number_of_experts = 128;
+    const size_t topk = 8;
+
+    auto hidden_states = std::make_shared<ov::op::v0::Parameter>(element::f16, Shape{tokens, hidden_size});
+    auto routers = op::v0::Constant::create(element::f16, Shape{hidden_size, number_of_experts}, {0.2f});
+    auto routing_weights = std::make_shared<ov::op::v0::MatMul>(hidden_states, routers);
+
+    // Gemma sigmoid routing: Sigmoid → TopK → Multiply(TopK_values, const) → Slice → Transpose → Unsqueeze
+    auto sigmoid = std::make_shared<ov::op::v0::Sigmoid>(routing_weights);
+    auto k_const = op::v0::Constant::create(element::i64, Shape{}, {static_cast<int64_t>(topk)});
+    auto topk_node = std::make_shared<ov::op::v11::TopK>(sigmoid, k_const, -1,
+        ov::op::v11::TopK::Mode::MAX, ov::op::v11::TopK::SortType::SORT_VALUES, element::i64);
+    // Multiply routing values (no Divide-based normalization)
+    auto routing_mul = std::make_shared<ov::op::v1::Multiply>(topk_node->output(0),
+        op::v0::Constant::create(element::f16, Shape{1, 1}, {1.0f}));
+    // Slice
+    auto slice_start = op::v0::Constant::create(element::i64, Shape{1}, {0});
+    auto slice_stop = op::v0::Constant::create(element::i64, Shape{1}, {static_cast<int64_t>(tokens)});
+    auto slice_step = op::v0::Constant::create(element::i64, Shape{1}, {1});
+    auto slice_axes = op::v0::Constant::create(element::i64, Shape{1}, {0});
+    auto routing_slice = std::make_shared<ov::op::v8::Slice>(routing_mul, slice_start, slice_stop, slice_step, slice_axes);
+    // Transpose → Unsqueeze
+    auto transpose_order = op::v0::Constant::create(element::i64, Shape{2}, {1, 0});
+    auto routing_transpose = std::make_shared<ov::op::v1::Transpose>(routing_slice, transpose_order);
+    auto unsqueeze_axis = op::v0::Constant::create(element::i64, Shape{1}, {-1});
+    auto routing_unsqueeze = std::make_shared<ov::op::v0::Unsqueeze>(routing_transpose, unsqueeze_axis);
+
+    auto topk_indices = std::make_shared<ov::op::v0::Convert>(topk_node->output(1), element::i32);
+
+    // Compressed weights
+    auto wei_gate = op::v0::Constant::create(element::u4, Shape{number_of_experts, inter_size, 16, 128}, {1});
+    auto scale_gate = op::v0::Constant::create(element::f16, Shape{number_of_experts, inter_size, 16}, {0.01f});
+    auto zp_gate = op::v0::Constant::create(element::u4, Shape{number_of_experts, inter_size, 16}, {0});
+    auto wei_up = op::v0::Constant::create(element::u4, Shape{number_of_experts, inter_size, 16, 128}, {1});
+    auto scale_up = op::v0::Constant::create(element::f16, Shape{number_of_experts, inter_size, 16}, {0.01f});
+    auto zp_up = op::v0::Constant::create(element::u4, Shape{number_of_experts, inter_size, 16}, {0});
+    auto wei_down = op::v0::Constant::create(element::u4, Shape{number_of_experts, hidden_size, 6, 128}, {1});
+    auto scale_down = op::v0::Constant::create(element::f16, Shape{number_of_experts, hidden_size, 6}, {0.01f});
+    auto zp_down = op::v0::Constant::create(element::u4, Shape{number_of_experts, hidden_size, 6}, {0});
+
+    ov::op::internal::MOECompressed::Config config;
+    config.expert_type = ov::op::internal::MOE::Expert_type::GEMM3_GEGLU;
+    config.has_zp = true;
+    config.hidden_size = hidden_size;
+    config.inter_size = inter_size;
+    config.num_expert = number_of_experts;
+    config.group_size = 128;
+    config.top_k = topk;
+    config.out_type = element::f16;
+
+    auto moe_compressed = std::make_shared<ov::op::internal::MOECompressed>(
+        ov::OutputVector{hidden_states, routing_unsqueeze, topk_indices,
+            wei_gate, scale_gate, zp_gate, wei_up, scale_up, zp_up, wei_down, scale_down, zp_down}, config);
+
+    model = std::make_shared<ov::Model>(ov::OutputVector{moe_compressed}, ov::ParameterVector{hidden_states});
+    manager.register_pass<ov::intel_gpu::FuseMOE3GemmCompressed>();
+    // model_ref intentionally not set: pass should NOT fire (Gemma routing unsupported).
+}
